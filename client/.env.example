# NGA Discipline & Attendance — client environment.
# Copy this file to `.env` and adjust as needed. NEVER commit the real `.env`.

# Where users are sent to authenticate: the Central MIS that start.bat runs
# on this machine.
VITE_MIS_LOGIN_URL=http://localhost:5173/login

# Home URLs for the apps waffle switcher in the top bar (local copies).
VITE_MIS_HOME_URL=http://localhost:5173
VITE_TASKMENTOR_HOME_URL=http://localhost:5174/taskmentor/

# OAuth client id for this subsystem (must match the server's SSO_CLIENT_ID).
VITE_SSO_CLIENT_ID=discipline_attendance

# Base path for API calls (proxied to the Express server in dev via vite.config.ts).
VITE_API_BASE_URL=/api
