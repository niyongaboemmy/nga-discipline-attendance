# NGA Discipline & Attendance — client environment.
# Copy this file to `.env` and adjust as needed. NEVER commit the real `.env`.

# Where users are sent to authenticate with the NGA Central MIS.
VITE_MIS_LOGIN_URL=https://mis.amashuri.com/login

# Home URLs for the apps waffle switcher in the top bar.
VITE_MIS_HOME_URL=https://mis.amashuri.com
VITE_TASKMENTOR_HOME_URL=https://taskmentor.amashuri.com

# OAuth client id for this subsystem (must match the server's SSO_CLIENT_ID).
VITE_SSO_CLIENT_ID=tendo_dev

# Base path for API calls (proxied to the Express server in dev via vite.config.ts).
VITE_API_BASE_URL=/api
