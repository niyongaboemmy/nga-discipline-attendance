# NGA Discipline & Attendance — server environment.
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# Port the Express API listens on.
PORT=5171

# Base URL of the NGA Central MIS used for SSO token exchange and roster sync.
NGA_MIS_BASE_URL=https://ngamis.isengesho.com

# OAuth client credentials issued by the NGA Central MIS for this subsystem.
SSO_CLIENT_ID=discipline_attendance
SSO_CLIENT_SECRET=replace_with_real_client_secret

# Secret used to sign session JWTs. MUST be a long random string in production.
# The server refuses to start in production if this is left at the default value.
JWT_SECRET=change_me_to_a_long_random_secret

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/attendance.db

# Comma-separated list of browser origins allowed to call this API.
# Set this to the deployed client URL(s) in production.
CORS_ORIGINS=http://localhost:5172,http://127.0.0.1:5172

# Bootstrap administrators. The NGA Central MIS is permission-based and grants no
# app-specific role, so roles here are derived from MIS permissions (student /
# teacher / admin). These allowlists force 'admin' for the named accounts
# regardless of their MIS permissions — set at least one to bootstrap the first
# administrator, who can then assign roles to everyone else. Case-insensitive;
# match on MIS username and/or email.
# ADMIN_USERNAMES=levi
# ADMIN_EMAILS=owner@example.com

# Optional: override the MIS roster resource paths if the NGA Central MIS
# exposes them somewhere other than the defaults below (relative to
# NGA_MIS_BASE_URL). Used by the roster proxy in src/routes/mis.ts.
# MIS_CLASSES_PATH=/classes
# MIS_STUDENTS_PATH=/students
# MIS_STAFF_PATH=/staff
# MIS_SCHEDULE_PATH=/schedule
